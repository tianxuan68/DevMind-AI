MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=<请填写>
MYSQL_DATABASE=internal_tech_kb
REDIS_HOST=localhost
REDIS_PORT=16379
JWT_SECRET=<请填写>
# 与 JWT_SECRET 共用：工作台登录 token 可直连 /api/query、WS /api/stream
SSO_MODE=jwt
APP_DEBUG=false
CLIENT_BACKEND_PORT=8004
SSO_JWKS_URL=

# Spug 短信（生产环境设为 true，凭证勿提交仓库）
# POST https://push.spug.cc/send/<SPUG_SMS_TEMPLATE>  body: code, number, targets
SPUG_SMS_ENABLED=false
SPUG_SMS_MODE=send
SPUG_SMS_TEMPLATE=k2RVBmyzanj0ny3b
SPUG_SMS_SEND_URL=https://push.spug.cc/send/k2RVBmyzanj0ny3b
SPUG_SMS_APP_NAME=DevMind AI
SPUG_SMS_APP_KEY=
SPUG_SMS_CREDENTIAL=
SPUG_SMS_NUMBER=10

# 阿里云 OSS Python SDK V2（华北2-北京 / Bucket: devmindai）
# 凭证必须通过环境变量注入（勿写入 config.ini）：
OSS_ENABLED=true
OSS_REGION=cn-beijing
OSS_BUCKET=devmindai
OSS_PREFIX=devmind-ai
OSS_PRESIGN_EXPIRES=3600
OSS_ACCESS_KEY_ID=<请填写>
OSS_ACCESS_KEY_SECRET=<请填写>
# Bucket CORS 需允许 PUT/GET/HEAD，来源含 http://localhost:5173 与 http://127.0.0.1:5173，AllowedHeader=*

# 阿里云百炼 / DashScope（LLM Query 改写、意图分类、RAG 生成；勿提交仓库）
# 优先级：环境变量 > config.ini [llm] dashscope_api_key
DASHSCOPE_API_KEY=<请填写>
